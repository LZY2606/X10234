{
  "name": "tilt-room",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "倾转帧拼合室：电镜 tilt-series 轴线、fiducial 轨迹与配准分支审阅工具",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:case": "node --experimental-strip-types scripts/generate-case.ts",
    "serve:prod": "node --experimental-strip-types scripts/serve-prod.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5",
    "happy-dom": "^15.11.7",
    "@types/node": "^22.9.0"
  }
}
