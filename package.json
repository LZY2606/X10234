{
  "name": "tilt-alignment-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "倾转帧拼合室：电镜 tilt-series 轴线、fiducial 轨迹与配准分支审阅工具",
  "scripts": {
    "build:case": "tsx scripts/build-case.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "server:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "e2e": "playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
