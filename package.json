{
  "name": "tilt-series-registration-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "电子断层倾转序列配准审阅工具：版本化来源、fiducial 轨迹、多候选裁定与离线案例包",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "case-pack": "node --experimental-strip-types server/scripts/generate-case-pack.ts"
  },
  "dependencies": {
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/sql.js": "^1.4.9",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
