{
  "name": "tilt-fusion-room",
  "version": "1.0.0",
  "private": true,
  "description": "倾转帧拼合室：电镜 tilt-series 轴线、fiducial 轨迹与配准分支审阅工具",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5349 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "casepack": "node --experimental-strip-types src/cli/build-casepack.ts",
    "pretest": "npm run casepack && tsc --noEmit",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "puppeteer-core": "^23.10.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
